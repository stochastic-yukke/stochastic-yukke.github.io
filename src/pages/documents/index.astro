---
import Layout from '../../layouts/Layout.astro';
import {documents} from '../../data/documents';
---

<Layout title="Archive">
  <h1>Archive</h1>
  <ul>
    {
    documents.map((d) => (
      <li>
        <a href={`/documents/${d.slug}/`}>{d.title}</a>
        {d.date && <span class="meta">（{d.date}）</span>}
        {d.description && <br />}
        {d.description}
      </li>
    ))
    }
  </ul>
</Layout>