---
import '@fontsource/stix-two-text/500.css';
import '@fontsource/stix-two-text/500-italic.css';
import '@fontsource/stix-two-text/700.css';
import '@fontsource/noto-serif-jp/500.css';
import '@fontsource/noto-serif-jp/700.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

// Markdownページではfrontmatterを渡す。Astroページではtitleを直接渡す。
interface Props {
  title?: string;
  hero?: boolean;
  frontmatter?: { title?: string; date?: string; [key: string]: unknown };
}
const { frontmatter, hero = false } = Astro.props;
const isNote = Boolean(frontmatter);
const title = Astro.props.title ?? frontmatter?.title;

// scripts/subset_fonts.pyが読み取る値；書き換えたらスクリプトを再実行してねー
const siteName = '真砂なす数なき山顚の';
const pageTitle = title ? `${title} | ${siteName}` : siteName;

// hero用: サイト名を縦書きで並べる列の字数
const heroSplit = [4, 3, 3];
const heroChars = [...siteName].map((ch, k) => {
  let g = 0;
  let r = k;
  while (g < heroSplit.length - 1 && r >= heroSplit[g]) {
    r -= heroSplit[g];
    g += 1;
  }
  return { ch, k, g, r };
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2eb" id="theme-color" />
    <title>{pageTitle}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={hero ? 'has-hero' : undefined}>
    <header class="site-header">
      {
        hero ? (
          <a class="site-title" href="/" aria-label={siteName}>
            <span class="site-name" aria-hidden="true">
              {heroChars.map((c) => (
                <span class="ch" style={`--k:${c.k};--g:${c.g};--r:${c.r}`}>
                  {c.ch}
                </span>
              ))}
            </span>
          </a>
        ) : (
          <a class="site-title" href="/">
            <span class="site-name">{siteName}</span>
          </a>
        )
      }
    </header>
    {hero && (
      <>
        <div class="night-sky" aria-hidden="true">
          <canvas id="starfield"></canvas>
        </div>
        <div class="hero-spacer" aria-hidden="true" />
        <div class="scroll-indicator" aria-hidden="true">Scroll</div>
      </>
    )}

    <main>
      {
        isNote && (
          <>
            <h1>{title}</h1>
            {frontmatter?.date && <p class="meta">{frontmatter.date}</p>}
          </>
        )
      }
      <slot />
    </main>

    <footer class="site-footer">
      <nav class="footer-nav" aria-label="サイト内の移動">
        <a href="/">home</a>
        <a href="/marginalia/">marginalia</a>
        <a href="/archive/">archive</a>
      </nav>
      <div class="sns-links">
        <a href="https://x.com/_stochastikke" target="_blank" rel="noopener noreferrer" aria-label="X (formerly Twitter)" data-x-joke>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
            <path class="logo-bird" d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.502 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
            <path class="logo-x" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
      </div>
      <div class="copyright">
        &copy; {new Date().getFullYear()} <span class="site-name">{siteName}</span>
      </div>
    </footer>

    <script is:inline>
      // スクロール量得た --p で星を描く
      (function () {
        if (!document.querySelector('.has-hero')) return;
        var root = document.documentElement;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var meta = document.getElementById('theme-color');
        var SKY = '#0b101d';
        var PAPER = '#f5f2eb';
        var RANGE = 0.92; // 動作の終了までのスクロール量
        var ticking = false;

        function update() {
          ticking = false;
          var p = Math.min(Math.max(scrollY / (innerHeight * RANGE), 0), 1);
          if (reduce) p = scrollY > 40 ? 1 : 0; // 動きを減らす
          root.style.setProperty('--p', p.toFixed(4));
          if (meta) meta.setAttribute('content', p < 0.9 ? SKY : PAPER);
        }

        function onScroll() {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll);

        var sky = document.querySelector('.night-sky');
        var canvas = document.getElementById('starfield');
        var ctx = canvas ? canvas.getContext('2d') : null;

        function drawStars() {
          if (!canvas || !ctx) return;
          var w = canvas.clientWidth;
          var h = canvas.clientHeight;
          if (!w || !h) return;
          var dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, w, h);
          var n = Math.round((w * h) / 4500);
          for (var i = 0; i < n; i++) {
            ctx.beginPath();
            ctx.arc(Math.random() * w, Math.random() * h, 0.25 + Math.random() * 1.0, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255, 255, 255, ' + Math.random().toFixed(2) + ')';
            ctx.fill();
          }
        }

        if (sky && 'ResizeObserver' in window) new ResizeObserver(drawStars).observe(sky);
        else drawStars();

        update();
      })();
    </script>
  </body>
</html>

<style is:global>
  .footer-nav {
    display: flex;
    justify-content: center;
    gap: 0.4em 1.6em;
    margin-bottom: 0.8em;
  }

  .footer-nav a {
    color: inherit;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .footer-nav a:hover {
    text-decoration: underline;
  }
</style>